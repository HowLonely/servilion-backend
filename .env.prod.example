# Para 18.220.10.50 usa api.18-220-10-50.nip.io y
# web.18-220-10-50.nip.io. nip.io resuelve ambos a esa misma IP.
API_DOMAIN=api.REEMPLAZAR-IP-CON-GUIONES.nip.io
WEB_DOMAIN=web.REEMPLAZAR-IP-CON-GUIONES.nip.io

DEBUG=False
SECRET_KEY=REEMPLAZAR_SECRET_KEY
JWT_SECRET=REEMPLAZAR_JWT_SECRET

POSTGRES_DB=servilion
POSTGRES_USER=servilion
POSTGRES_PASSWORD=REEMPLAZAR_POSTGRES_PASSWORD
DATABASE_URL=postgresql://servilion:REEMPLAZAR_POSTGRES_PASSWORD@db:5432/servilion

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://api.REEMPLAZAR-IP-CON-GUIONES.nip.io,https://web.REEMPLAZAR-IP-CON-GUIONES.nip.io
CORS_ALLOWED_ORIGINS=https://web.REEMPLAZAR-IP-CON-GUIONES.nip.io,http://localhost:3000

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True